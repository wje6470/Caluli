# --- 資料庫 ---
DATABASE_URL=postgresql+psycopg://caluli:caluli@localhost:5432/caluli

# --- 會話 ---
# 正式環境務必覆寫，且長度須 >= 32 bytes（HMAC-SHA256 建議下限）
JWT_SECRET=dev-only-insecure-secret-please-override-in-production
JWT_EXPIRES_SECONDS=604800

# --- LINE Login ---
# 兩個入口（LIFF / 一般網頁）共用同一組設定
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# --- 辨識服務（同機內部呼叫）---
RECOGNITION_SERVICE_URL=http://localhost:8900
# OQ-4：暫定值，需以 recognition_jobs.duration_ms 實測後校準
RECOGNITION_TIMEOUT_SECONDS=30

# --- 照片 ---
PHOTO_STORAGE_ROOT=./var/photos
PHOTO_MAX_BYTES=10485760

APP_TIMEZONE=Asia/Taipei

# --- 管理員名單（第三輪）---
#
# 可進入後台的 LINE user ID，**半形逗號分隔**（不是 JSON 陣列）。
# LINE user ID 是 U 開頭的 33 字元字串，不是 LINE 顯示名稱或 @ 開頭的 LINE ID。
# 取得方式：讓該帳號先正常登入一次，再查 select line_user_id from users;
#
# 留空 = 無人是管理員，後台無人可進入（不是全體開放）。
# 修改後需重啟後端，且該使用者需重新登入才會生效。
#
# ⚠️ 這個值決定誰能改動線上店家資料。正式環境請用部署平台的加密環境變數
#    設定，不要提交進版控。
# ⚠️ 直接在資料庫把 role 改成 admin 是無效的——下次登入會依此名單覆寫。
#    授予一律走名單；資料庫直改僅能作為緊急撤銷，且撤銷後須同步移出名單。
#
# ADMIN_LINE_USER_IDS=U0123456789abcdef0123456789abcdef,Uabcdef...
ADMIN_LINE_USER_IDS=
