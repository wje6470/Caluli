# 複製為 .env.local 後填入實際值。
# 注意：NEXT_PUBLIC_ 前綴的變數會被打包進瀏覽器端，不要放任何祕密
#（channel secret 只放後端）。

# 後端 API。若前端走 ngrok 而後端在本機，這裡仍填 http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# LIFF app ID（形如 2001234567-AbCdEfGh）。
# 留空 = 這個部署不走 LIFF，一律降級為一般網頁模式（憲章原則 II）。
NEXT_PUBLIC_LIFF_ID=

# LINE Login channel ID（純數字，例如 2001234567）。
# ⚠️ 與 LIFF ID 是不同的東西，但兩者必須屬於**同一個 channel**——
# 後端驗證 ID Token 時會以 channel ID 作為 audience 比對。
NEXT_PUBLIC_LINE_CHANNEL_ID=

# OAuth 回呼位址。必須與 LINE Developers 後台「Callback URL」逐字相同
# （含 http/https、port、結尾不加斜線）。
NEXT_PUBLIC_LINE_REDIRECT_URI=http://localhost:3000/auth/callback
